# Modo de ejecucion: local | azure | queue
AGENT_TARGET=local

# Puerto del proxy
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info

# CORS (opcional): lista separada por comas
# ALLOWED_ORIGINS=http://localhost:5173,https://tu-frontend.com
# Si queda vacia, el servidor permite cualquier origen (util para extension local).

# Limite de caracteres para el contenido de pestana enviado al agente
MAX_TAB_CONTENT_CHARS=12000
# Limite de codigo para endpoint /github-mentor
MAX_MENTOR_CODE_CHARS=6000
# Limite para uploads de imagenes
MAX_UPLOAD_BYTES=8388608

# -------- Local --------
OPENAI_BASE=http://127.0.0.1:11434/v1
OPENAI_API_KEY=dummy
MODEL_TEXT=qwen2.5:7b-instruct

OLLAMA_URL=http://127.0.0.1:11434
MODEL_VISION=qwen2.5vl:7b-gpu

# -------- Azure --------
# URL base del servidor remoto (sin slash final), por ejemplo:
# AZURE_SERVER_URL=https://mi-agente.azurewebsites.net
AZURE_SERVER_URL=https://app-adaceen-api-eyder05232002.azurewebsites.net
# Cloudflare no se usa en produccion/Azure. Solo sirve como tunel local opcional.
CLOUDFLARE_USAGE=local-only

# -------- Azure queue mode --------
# Cambia AGENT_TARGET=queue arriba para activar este modo.
# AGENT_TARGET=queue
AZURE_SERVICEBUS_CONNECTION_STRING=
JOBS_QUEUE_NAME=llm-jobs
RESULTS_QUEUE_NAME=llm-results
WORKER_SHARED_SECRET=
PUBLIC_API_URL=

# -------- Worker local --------
WORKER_ID=pc-central-gpu
WORKER_ROLE=local_gpu_coder
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_CONTEXT=8192
OLLAMA_STATUS_TIMEOUT_MS=2500
OLLAMA_FAST_MODEL=qwen2.5-coder:7b
OLLAMA_FAST_CONTEXT=4096
OLLAMA_CLASSIFIER_MODEL=qwen2.5:7b
OLLAMA_CLASSIFIER_CONTEXT=4096
# OLLAMA_EXPERIMENTAL_MODEL=qwen3-coder-next
VRAM_GB=48
WORKER_MAX_CONCURRENCY=1
MAX_PARALLEL_JOBS=1

# -------- Base de datos --------
# Si DATABASE_URL queda vacia, el backend usa una base PostgreSQL en memoria
# con usuarios demo y politicas seed para el piloto.
# Para Azure, apunta este valor al servidor de PostgreSQL Flexible Server.
# Ejemplo Azure: postgresql://usuario:password@servidor.postgres.database.azure.com:5432/agente?sslmode=require
DATABASE_URL=
# disable | require
DATABASE_SSL_MODE=disable
