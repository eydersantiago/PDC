# Modo de ejecucion:
# - local: usa OPENAI_BASE/OLLAMA local desde este proceso.
# - azure: reenvia /run-text y /run-image a AZURE_SERVER_URL por HTTP.
# - queue: publica jobs en Azure Service Bus para que un worker local con Ollama responda.
AGENT_TARGET=local

# Puerto del proxy
PORT=3000

# Logs estructurados: debug | info | warn | error.
# ADACEEN_LOG_STACKS=1 agrega stack traces cortos en errores.
ADACEEN_LOG_LEVEL=info
ADACEEN_LOG_STACKS=0

# CORS (opcional): lista separada por comas. Vacio = permite cualquier origen.
# Ejemplo: http://localhost:5173,https://tu-frontend.com
ALLOWED_ORIGINS=

# Limites de contenido enviados al agente
MAX_TAB_CONTENT_CHARS=12000
MAX_MENTOR_CODE_CHARS=6000

# Ruta del dashboard tras completar la preparacion GitHub App
DASHBOARD_ROUTE=/dashboard

# Carga temporal de imagenes para /run-image y /run
UPLOADS_DIR=uploads
IMAGE_UPLOAD_MAX_BYTES=8388608
IMAGE_UPLOAD_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,image/gif,image/bmp,image/tiff

# -------- Local / modelos --------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_BASE=http://127.0.0.1:11434/v1
OPENAI_API_KEY=dummy
OLLAMA_MODEL=qwen2.5-coder:7b
MODEL_TEXT=

OLLAMA_URL=http://127.0.0.1:11434
MODEL_VISION=qwen2.5vl:7b-gpu
OLLAMA_VISION_NUM_GPU=24
OLLAMA_VISION_NUM_CTX=768
OLLAMA_VISION_NUM_BATCH=24

# -------- Azure --------
# URL base del servidor remoto (sin slash final), por ejemplo:
# AZURE_SERVER_URL=https://mi-agente.azurewebsites.net
AZURE_SERVER_URL=
# Para AGENT_TARGET=queue: App Service publica en JOBS_QUEUE_NAME y espera respuesta
# en RESULTS_QUEUE_NAME. La cola de resultados debe tener sesiones habilitadas,
# porque cada request espera por sessionId=jobId.
AZURE_SERVICEBUS_CONNECTION_STRING=
JOBS_QUEUE_NAME=adaceen-jobs
RESULTS_QUEUE_NAME=adaceen-results
WORKER_SHARED_SECRET=
QUEUE_REQUEST_TIMEOUT_MS=120000
# URL publica del backend, usada para enlaces canonicos como /privacy-policy.
PUBLIC_API_URL=
# Email publico opcional mostrado en /privacy-policy para solicitudes de datos.
PRIVACY_CONTACT_EMAIL=

# -------- Base de datos --------
# Si DATABASE_URL queda vacia, el backend usa una base PostgreSQL en memoria
# con usuarios demo y politicas seed para el piloto.
# Ejemplo local:
# DATABASE_URL=postgresql://adaceen_user:tu_password@localhost:5432/adaceen
# Para Azure, apunta este valor al servidor de PostgreSQL Flexible Server.
DATABASE_URL=
# disable | require
DATABASE_SSL_MODE=disable

# -------- GitHub App (repo/PR) --------
# Id numerico de la GitHub App
GITHUB_APP_ID=
# Slug de la app, por ejemplo: adaceen-devcontainer-bootstrap
GITHUB_APP_SLUG=
# Llave privada PEM de la app. Puede pegarse con saltos o con \n.
GITHUB_APP_PRIVATE_KEY=
# Setup URL configurado en la app, por ejemplo:
# http://127.0.0.1:3000/api/github-app/callback
GITHUB_APP_SETUP_URL=http://127.0.0.1:3000/api/github-app/callback
# API base de GitHub (normalmente no cambiar)
GITHUB_API_BASE_URL=https://api.github.com

# -------- GitHub OAuth por usuario (Codespaces) --------
# Crea un OAuth App en GitHub Developer settings y apunta el callback a:
# http://127.0.0.1:3000/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
# Pega aqui el Client secret de la OAuth App. No uses GITHUB_APP_PRIVATE_KEY.
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:3000/auth/github/callback
# Scopes recomendados para que cada estudiante cree su propio Codespace.
GITHUB_OAUTH_SCOPES=repo codespace read:user user:email

# Token OAuth/PAT con permisos Codespaces.
# Respaldo de desarrollo si OAuth por usuario no esta conectado.
GITHUB_CODESPACES_USER_TOKEN=
# Region opcional para crear Codespaces: UsEast, UsWest, EuropeWest, SoutheastAsia.
GITHUB_CODESPACES_GEO=UsEast
# Espera maxima y polling al crear/reanudar Codespaces.
GITHUB_CODESPACES_WAIT_TIMEOUT_MS=180000
GITHUB_CODESPACES_POLL_MS=5000

# -------- Login con Google --------
# Client ID OAuth 2.0 (Chrome Extension / Chrome App) creado en Google Cloud Console.
GOOGLE_CLIENT_ID=
# Password por defecto para usuarios creados automaticamente via Google.
# Se almacena hasheada y sirve como credencial inicial del flujo interno.
GOOGLE_DEFAULT_PASSWORD=
# Opcional: restringe el acceso solo a un dominio (ej. adaceen.edu.co)
GOOGLE_ALLOWED_HOSTED_DOMAIN=

# -------- Worker de escaneo VS Code --------
# Si se configura, el backend exigira esta clave a la extension VS Code.
ADACEEN_SCAN_WORKER_KEY=
# Carpeta donde se guardan snapshots de codigo escaneado.
# Si queda vacia, usa agente-proxy-azure/data/project-scans.
PROJECT_SCANS_DIR=
# Carpeta donde se guardan capturas usadas para OCR/insight visual.
# Si queda vacia, usa agente-proxy-azure/data/project-screenshots.
PROJECT_SCREENSHOTS_DIR=
# Valores por defecto para el flujo de escaneo/rebuild.
DEFAULT_SCAN_SOURCE=dashboard_explore
DEFAULT_SCAN_WORKER_ID=vscode-ext-worker

# -------- RAG --------
RAG_SEED_PATH=data/rag/rag_sources_seed.jsonl
RAG_UPLOAD_MAX_BYTES=20971520
RAG_MAX_EXTRACTED_TEXT_CHARS=180000
RAG_CHUNK_TARGET_CHARS=1600
RAG_CHUNK_OVERLAP_CHARS=220
RAG_MIN_CHUNK_CHARS=320
RAG_MAX_CHUNKS_PER_SOURCE=180
RAG_MAX_SOURCES=5
RAG_PROMPT_MAX_CHARS=6000
