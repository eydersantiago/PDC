# Configuracion para instalar ADACEEN en las Mac del laboratorio.
#
# Copia este archivo FUERA del repositorio (por ejemplo a una memoria USB),
# completa los valores y pasalo al instalador en cada Mac:
#   bash deploy/mac/instalar-worker-mac.sh --equipo=07 --config=/Volumes/USB/adaceen-mac.env
#
# Tiene secretos: no lo subas al repositorio ni lo dejes en una carpeta compartida.
# El instalador lo copia a ~/.adaceen/worker.env (permisos 600) en cada Mac.

# Politica de Service Bus del namespace con SOLO Listen y Send (no RootManageSharedAccessKey).
AZURE_SERVICEBUS_CONNECTION_STRING=
# El mismo WORKER_SHARED_SECRET del App Service.
WORKER_SHARED_SECRET=
# El mismo WORKER_HEARTBEAT_TOKEN del App Service (latido: monitor y /api/agent/health).
WORKER_HEARTBEAT_TOKEN=

# Opcionales
BACKEND_URL=https://app-adaceen-api-eyder05232002.azurewebsites.net
JOBS_QUEUE_NAME=llm-jobs
RESULTS_QUEUE_NAME=llm-results-sessions
QUEUE_REQUEST_TIMEOUT_MS=120000
# Solo si la red del laboratorio obliga a salir por un proxy (por ejemplo http://proxy:3128).
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
