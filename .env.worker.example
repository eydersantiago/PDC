AGENT_TARGET=queue
AZURE_SERVICEBUS_CONNECTION_STRING=
JOBS_QUEUE_NAME=llm-jobs
RESULTS_QUEUE_NAME=llm-results-sessions
WORKER_SHARED_SECRET=
QUEUE_REQUEST_TIMEOUT_MS=120000
# Identificador visible en logs/resultados. Vacio = DEFAULT_SCAN_WORKER_ID-hostname.
QUEUE_WORKER_ID=
# Intentos totales entre workers antes de responder el error al backend.
QUEUE_WORKER_MAX_ATTEMPTS=3
# Pausa tras liberar un job fallido, para que otro worker lo tome primero.
QUEUE_WORKER_RETRY_DELAY_MS=2000
# Ventana de renovacion automatica del lock. 0 = QUEUE_REQUEST_TIMEOUT_MS + 30s.
QUEUE_WORKER_LOCK_RENEWAL_MS=0
# Jobs a la vez (1 a 8). Debe coincidir con OLLAMA_NUM_PARALLEL de Ollama.
QUEUE_WORKER_CONCURRENCY=1
# Tipos de job que atiende: text,image (una Mac sin modelo de vision: text).
QUEUE_WORKER_KINDS=text,image
# normal: compite por cada job. backup: solo toma los jobs que los demas workers
# no alcanzan a tomar (una Mac lenta junto a la GPU); descansa BACKUP_IDLE_MS entre consultas.
QUEUE_WORKER_PRIORITY=normal
QUEUE_WORKER_BACKUP_IDLE_MS=3000
# Precarga del modelo de texto al arrancar (0 = no).
QUEUE_WORKER_WARMUP=1
# Solo pide jobs mientras esta URL responde 2xx (cluster de Mac: /health de llama-server). Vacio = siempre.
QUEUE_WORKER_READY_URL=
# amqp (puerto 5671, por defecto) o websockets (HTTPS 443; usa HTTPS_PROXY si existe).
# En las Mac del laboratorio: websockets (docs/operacion/worker-mac.md).
SERVICE_BUS_TRANSPORT=amqp
ADACEEN_LOG_LEVEL=info
ADACEEN_LOG_STACKS=0

OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=dummy
OLLAMA_MODEL=qwen2.5-coder:7b
MODEL_TEXT=

# Latido hacia el API (A15.4): URL completa de POST /api/agent/heartbeat y el
# mismo token que WORKER_HEARTBEAT_TOKEN del App Service. Vacio = sin latido.
WORKER_HEARTBEAT_URL=
WORKER_HEARTBEAT_TOKEN=
WORKER_HEARTBEAT_INTERVAL_MS=30000
