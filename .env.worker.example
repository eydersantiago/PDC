# Worker local ADACEEN/PDC. Copia a .env.worker y completa los secretos.
# El worker carga .env primero y luego los valores no vacios de .env.worker,
# que tienen prioridad.
AGENT_TARGET=queue
LOG_LEVEL=info

AZURE_SERVICEBUS_CONNECTION_STRING=
JOBS_QUEUE_NAME=llm-jobs
RESULTS_QUEUE_NAME=llm-results

# Puedes usar ADACEEN_API_URL o PUBLIC_API_URL; si ambas quedan vacias,
# el worker usa AZURE_SERVER_URL desde .env como fallback.
ADACEEN_API_URL=
PUBLIC_API_URL=https://app-adaceen-api-eyder05232002.azurewebsites.net
WORKER_SHARED_SECRET=
WORKER_ID=pc-central-gpu
WORKER_ROLE=local_gpu_coder
VRAM_GB=48

# Ollama debe quedar local; no expongas este puerto a Internet.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Modelo principal para tutoría, análisis de repo, errores, PRs y planes.
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_CONTEXT=8192

# Modelos auxiliares. Instálalos solo si quieres que el router los use.
OLLAMA_FAST_MODEL=qwen2.5-coder:7b
OLLAMA_FAST_CONTEXT=4096
OLLAMA_CLASSIFIER_MODEL=qwen2.5:7b
OLLAMA_CLASSIFIER_CONTEXT=4096

# Perfil experimental; déjalo vacío hasta probar estabilidad/VRAM.
# OLLAMA_EXPERIMENTAL_MODEL=qwen3-coder-next
OLLAMA_EXPERIMENTAL_CONTEXT=8192

# Con 3 GPUs de 16 GB, empieza con un job pesado a la vez.
WORKER_MAX_CONCURRENCY=1
MAX_PARALLEL_JOBS=1
OLLAMA_TIMEOUT_MS=180000
OLLAMA_STATUS_TIMEOUT_MS=2500

# Configura esto en el proceso de Ollama antes de ollama serve si lo ejecutas manualmente.
OLLAMA_NUM_PARALLEL=1

# Opcional: si lo defines, el worker rechazará cualquier modelo fuera de esta lista.
# Si lo dejas vacío, se genera desde OLLAMA_MODEL/FAST/CLASSIFIER/EXPERIMENTAL.
# SUPPORTED_MODELS=qwen3-coder:30b,qwen2.5-coder:7b,qwen2.5:7b
