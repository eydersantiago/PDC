{
  "manifest_version": 3,
  "name": "ADACEEN",
  "version": "0.7.0",
  "key": "",
  "description": "Tutor contextual para apoyar el aprendizaje de programacion en Campus Virtual y GitHub/Codespaces.",
  "permissions": ["activeTab", "storage", "tabs", "scripting", "identity"],
  "oauth2": {
    "client_id": "676906034486-0ei09khcf64m5lk3vc5f3q9p322ktnek.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "host_permissions": [
    "https://campusvirtual.univalle.edu.co/*",
    "https://github.com/*",
    "https://github.dev/*",
    "https://*.github.dev/*",
    "https://app.github.dev/*",
    "https://*.app.github.dev/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*",
    "https://app-agente-poc.azurewebsites.net/*",
    "https://*.azurewebsites.net/*"
  ],
  "action": { "default_title": "ADACEEN" },
  "background": {
    "service_worker": "background.js"
  },
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://campusvirtual.univalle.edu.co/*",
        "https://github.com/*",
        "https://github.dev/*",
        "https://*.github.dev/*",
        "https://app.github.dev/*",
        "https://*.app.github.dev/*"
      ],
      "js": [
        "content-core.js",
        "content-context.js",
        "content-project.js",
        "content-setup.js",
        "content-guidance.js",
        "content-api.js",
        "content-styles.js",
        "content-markup.js",
        "content-render.js",
        "content-lifecycle.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
